{
    "compilerOptions": {
        "target": "es5",
        "lib": [
            "dom",
            "dom.iterable",
            "esnext"
        ],
        "allowJs": true,
        "skipLibCheck": true,
        "strict": false,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "preserve",
        "incremental": true,
        "types": [
            "node",
            "jest"
        ],
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "packages/baccarat-multiplayer/src/*"
            ],
            "@shared": [
                "packages/shared/src"
            ],
            "@shared/*": [
                "packages/shared/src/*"
            ],
            "@sedie-multiplayer": [
                "packages/sedie-multiplayer/src"
            ],
            "@sedie-multiplayer/*": [
                "packages/sedie-multiplayer/src/*"
            ],
            "@baccarat-multiplayer": [
                "packages/baccarat-multiplayer/src"
            ],
            "@baccarat-multiplayer/*": [
                "packages/baccarat-multiplayer/src/*"
            ],
            "@plinko": [
                "packages/plinko/src"
            ],
            "@plinko/*": [
                "packages/plinko/src/*"
            ]
        }
    },
    "include": [
        "next-env.d.ts",
        "**/*.ts",
        "**/*.tsx",
        "**/*.js",
        "jest.config.ts",
        "packages/sedie-multiplayer/src/**/*",
        "packages/baccarat-multiplayer/src/**/*",
        "packages/shared/src/**/*"
    ],
    "exclude": [
        "node_modules",
        "packages/sedie-multiplayer/dist",
        "packages/baccarat-multiplayer/dist",
        "packages/shared/dist"
    ]
}