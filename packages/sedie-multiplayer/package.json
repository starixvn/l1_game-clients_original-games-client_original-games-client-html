{
    "name": "@games/sedie-multiplayer",
    "version": "0.1.0",
    "private": true,
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "clean": "rimraf dist",
        "generate-tolgee-data": "cd ../.. && cross-env NEXT_PUBLIC_DEFAULT_GAME_ID=148 npm run generate-tolgee-data && cd packages/sedie-multiplayer",
        "dev": "cross-env NEXT_PUBLIC_DEFAULT_GAME_ID=148 npm run generate-tolgee-data && cross-env NEXT_PUBLIC_DEFAULT_GAME_ID=148 NEXT_PUBLIC_BASE_PATH= PORT=3001 FAST_REFRESH=false node custom-server.js",
        "build:standalone": "cross-env NEXT_PUBLIC_DEFAULT_GAME_ID=148 npm run generate-tolgee-data && cross-env NEXT_PUBLIC_BASE_PATH=/site-148 next build",
        "start": "cross-env NEXT_PUBLIC_DEFAULT_GAME_ID=148 NEXT_PUBLIC_BASE_PATH= PORT=3001 node custom-server.js",
        "dev:dynamic": "node scripts/dev-dynamic.js",
        "build:dynamic": "node scripts/build-dynamic.js",
        "obfuscator-config-file": "node ./configs/config-obfuscator.js"
    },
    "dependencies": {
        "@sentry/nextjs": "^9.41.0",
        "@tolgee/format-icu": "^5.28.6",
        "@tolgee/react": "^5.28.6",
        "@use-gesture/react": "^10.3.1",
        "axios": "^0.30.0",
        "base64-string": "^1.1.2",
        "classnames": "^2.3.2",
        "clsx": "^2.1.1",
        "cross-env": "^7.0.3",
        "express": "^4.18.2",
        "gsap": "^3.13.0",
        "http-proxy-middleware": "^2.0.9",
        "interweave": "^13.1.0",
        "motion": "^12.23.12",
        "next": "14.2.31",
        "next-themes": "^0.3.0",
        "react": "^18.2.0",
        "react-canvas-confetti": "^1.2.1",
        "react-device-detect": "^2.2.3",
        "react-dom": "^18.2.0",
        "react-router-dom": "^6.21.2",
        "react-slick": "^0.29.0",
        "sc-scoreboards": "1.0.6",
        "sc-user-service-client": "1.7.0",
        "sharp": "^0.33.5",
        "slick-carousel": "^1.8.1",
        "socket.io-client": "^4.1.3",
        "socket.io-msgpack-parser": "^3.0.1",
        "styled-components": "^6.1.19",
        "swiper": "^11.1.1",
        "tailwind-merge": "^3.3.1",
        "unique-names-generator": "^4.7.1",
        "use-sound": "^4.0.1",
        "uuid": "^9.0.0",
        "ws": "^8.17.1",
        "zustand": "^5.0.7"
    },
    "devDependencies": {
        "@next/bundle-analyzer": "^14.2.31",
        "rimraf": "^5.0.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.0.0",
        "concurrently": "^8.2.2"
    },
    "resolutions": {
        "axios": "^0.30.0",
        "form-data": "^3.0.4"
    }
}
