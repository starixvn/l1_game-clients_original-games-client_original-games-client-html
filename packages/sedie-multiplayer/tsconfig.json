{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "outDir": "./dist",
        "declaration": true,
        "declarationMap": true,
        "baseUrl": ".",
        "paths": {
            "@shared": [
                "../shared/src/index"
            ],
            "@shared/*": [
                "../shared/src/*"
            ],
            "@/*": [
                "./src/*"
            ]
        }
    },
    "include": [
        "src/**/*",
        "../shared/src/**/*"
    ],
    "exclude": [
        "dist",
        "node_modules"
    ]
}