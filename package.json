{
    "name": "original-games-client-html",
    "version": "0.1.0",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "engines": {
        "node": ">=20.9.0"
    },
    "scripts": {
        "generate-tolgee-data": "npx ts-node --project tsconfig.node.json ./packages/shared/src/tolgee-generator.ts",
        "analyze": "cross-env ANALYZE=true next build",
        "dev": "npm run generate-tolgee-data && cross-env NEXT_PUBLIC_DEFAULT_GAME_ID=148 HOST=sedie.local PORT=3001 next dev -p 3001",
        "dev:standalone": "npm run generate-tolgee-data && next build && npm run copy-standalone-assets && node .next/standalone/server.js",
        "copy-standalone-assets": "node scripts/copy-standalone-assets.js",
        "build": "next build",
        "info": "next info",
        "start": "next start -p ${PORT:=5000}",
        "lint": "next lint",
        "test": "jest",
        "test:snapshot": "jest -u",
        "test:watch": "jest --watch",
        "test-coverage": "jest --coverage --maxWorkers=2",
        "test-coverage:ci": "jest --coverage --maxWorkers=1 --cache --ci",
        "obfuscator-config-file": "node ./configs/config-obfuscator.js"
    },
    "dependencies": {
        "@sentry/nextjs": "^10.19.0",
        "@tolgee/format-icu": "^5.28.6",
        "@tolgee/react": "^5.28.6",
        "@use-gesture/react": "^10.3.1",
        "axios": "^0.30.0",
        "base64-string": "^1.1.2",
        "clsx": "^2.1.1",
        "cors": "^2.8.5",
        "express": "^4.18.2",
        "gsap": "^3.13.0",
        "interweave": "^13.1.0",
        "motion": "^12.23.12",
        "next": "^14.2.25",
        "next-themes": "^0.3.0",
        "react": "^18.2.0",
        "react-canvas-confetti": "^1.2.1",
        "react-device-detect": "^2.2.3",
        "react-dom": "^18.2.0",
        "react-router-dom": "^6.21.2",
        "react-slick": "^0.29.0",
        "sc-scoreboards": "1.0.6",
        "sc-user-service-client": "1.7.0",
        "sharp": "^0.33.5",
        "slick-carousel": "^1.8.1",
        "socket.io-client": "^4.1.3",
        "socket.io-msgpack-parser": "^3.0.1",
        "styled-components": "^6.1.19",
        "swiper": "^11.1.1",
        "tailwind-merge": "^3.3.1",
        "unique-names-generator": "^4.7.1",
        "use-sound": "^4.0.1",
        "ws": "^8.17.1",
        "zustand": "^5.0.7"
    },
    "devDependencies": {
        "@babel/core": "^7.23.9",
        "@babel/preset-env": "^7.23.9",
        "@babel/preset-typescript": "^7.23.3",
        "@commitlint/cli": "^18.4.4",
        "@commitlint/config-conventional": "^18.4.4",
        "@next/bundle-analyzer": "^14.2.5",
        "@testing-library/jest-dom": "^6.3.0",
        "@testing-library/react": "^13.0.0",
        "@testing-library/react-hooks": "^8.0.0",
        "@testing-library/user-event": "^14.5.2",
        "@tolgee/web": "^5.28.6",
        "@types/howler": "^2.2.11",
        "@types/jest": "^29.0.0",
        "@types/lodash": "^4.17.0",
        "@types/node": "^20.11.1",
        "@types/react": "^18.2.47",
        "@types/react-dom": "^18.2.18",
        "@types/react-slick": "^0.23.13",
        "autoprefixer": "^10.4.21",
        "babel-jest": "^29.7.0",
        "concurrently": "^9.0.1",
        "cross-env": "^7.0.3",
        "eslint": "^8.56.0",
        "eslint-config-next": "^14.0.4",
        "form-data": "^3.0.4",
        "husky": "^8.0.3",
        "identity-obj-proxy": "^3.0.0",
        "javascript-obfuscator": "^4.1.0",
        "jest": "^29.0.0",
        "jest-auto-stub": "^1.0.8",
        "jest-environment-jsdom": "^29.7.0",
        "jest-extended": "^4.0.2",
        "jest-sonar-reporter": "^2.0.0",
        "jest-util": "^29.7.0",
        "mock-socket": "^9.3.1",
        "postcss": "^8.5.6",
        "sass": "^1.77.8",
        "socket.io-mock": "^1.3.2",
        "sonarqube-scanner": "^4.3.0",
        "tailwindcss": "3.4.17",
        "ts-jest": "29.1.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.5.4",
        "url-loader": "^4.1.1",
        "uuid": "^10.0.0"
    },
    "resolutions": {
        "axios": "^0.30.0",
        "braces": "^3.0.3",
        "form-data": "^3.0.4",
        "json5": "^2.2.3",
        "sane": "^5.0.0",
        "ws": "^8.17.1"
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    },
    "husky": {
        "hooks": {
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS",
            "pre-push": "yarn test"
        }
    }
}
